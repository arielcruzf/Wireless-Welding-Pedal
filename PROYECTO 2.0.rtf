2.3 Receiver Code (V5.0 Final)\
\pard\pardeftab720\sl276\partightenfactor0

\f1\b0\fs24 \cf2 C++\
\
#include <SPI.h>\
#include <nRF24L01.h>\
#include <RF24.h>\
\
RF24 radio(10, 9); \
const byte direccion[6] = "PEDAL";\
\
struct DatosPedal \{\
  int valorPot;\
\};\
\
DatosPedal miPedal;\
\
// CALIBRATION VARIABLES\
int PotMin = 80;                   \
int PotMax = 1000;                  \
unsigned long recoveryDelay = 800; // 0.8 seconds critical threshold\
\
unsigned long ultimaRecepcion = 0;\
bool sistemaBloqueado = true;     \
String statusActual = "INITIALIZING"; \
\
void setup() \{\
  Serial.begin(9600);\
  Serial.println(F("--- WELDER RECEIVER V5.0 ---"));\
\
  radio.begin();\
  radio.openReadingPipe(1, direccion);\
  radio.setPALevel(RF24_PA_LOW);   \
  radio.setDataRate(RF24_250KBPS); \
  radio.startListening();\
\
  pinMode(3, OUTPUT); // PWM Output (0-10V)\
  pinMode(4, OUTPUT); // RELAY 1: Torch Trigger\
  pinMode(5, OUTPUT); // RELAY 2: Potentiometer GND Isolation\
  \
  activarFailsafe();\
\}\
\
void loop() \{\
  // Radio Auto-Rescue (SPI Bus protection)\
  if (radio.failureDetected) \{\
    radio.begin();\
    radio.openReadingPipe(1, direccion);\
    radio.setPALevel(RF24_PA_LOW);\
    radio.setDataRate(RF24_250KBPS);\
    radio.startListening();\
    radio.failureDetected = false;\
  \}\
\
  // 1. DATA RECEPTION\
  if (radio.available()) \{\
    radio.read(&miPedal, sizeof(DatosPedal));\
    ultimaRecepcion = millis();\
    sistemaBloqueado = false;\
    statusActual = "CONNECTED";\
\
    int valorLimpio = constrain(miPedal.valorPot, PotMin, PotMax);\
    int salidaPWM;\
\
    // Absolute cut-off at rest position\
    if (miPedal.valorPot <= (PotMin + 10)) \{\
      salidaPWM = 0;\
      digitalWrite(3, LOW); \
    \} else \{\
      salidaPWM = map(valorLimpio, PotMin, PotMax, 0, 255);\
      analogWrite(3, salidaPWM); \
    \}\
\
    // Double Relay Activation (Torch & Ground Isolation)\
    bool estadoTrigger = (miPedal.valorPot > (PotMin + 25)) ? HIGH : LOW;\
    digitalWrite(4, estadoTrigger); // Fire Torch\
    digitalWrite(5, estadoTrigger); // Connect Ground\
  \}\
\
  // 2. STATUS & SECURITY MANAGEMENT (FAIL SAFE)\
  unsigned long tiempoSinDatos = millis() - ultimaRecepcion;\
\
  if (!sistemaBloqueado) \{\
    if (tiempoSinDatos > 100 && tiempoSinDatos < recoveryDelay) \{\
      statusActual = "LOST SIGNAL"; \
    \} \
    else if (tiempoSinDatos >= recoveryDelay) \{\
      activarFailsafe();\
      sistemaBloqueado = true;\
      statusActual = "FAIL SAFE - WELDER OFF";\
    \}\
  \}\
\
  imprimirTodo();\
\}\
\
void activarFailsafe() \{\
  digitalWrite(3, LOW); \
  digitalWrite(4, LOW); \
  digitalWrite(5, LOW); \
\}\
\
void imprimirTodo() \{\
  static unsigned long lp = 0;\
  if (millis() - lp > 200) \{ \
    int porcentaje = 0;\
    if (statusActual != "FAIL SAFE - WELDER OFF") \{\
        porcentaje = map(constrain(miPedal.valorPot, PotMin, PotMax), PotMin, PotMax, 0, 100);\
    \}\
    \
    Serial.print(F("POT: ")); Serial.print(miPedal.valorPot);\
    Serial.print(F(" | %: ")); Serial.print(porcentaje);\
    Serial.print(F(" | RELAYS: ")); Serial.print(digitalRead(4) ? F("ON") : F("OFF"));\
    Serial.print(F(" | STATUS: ")); Serial.println(statusActual);\
    \
    lp = millis();\
  \}\
\}\
