\f4\b\fs28 \cf2 1.3 Transmitter Code (C++)\
\pard\pardeftab720\sl276\partightenfactor0

\f3\b0\fs24 \cf2 C++\
\
#include <SPI.h>\
#include <nRF24L01.h>\
#include <RF24.h>\
\
RF24 radio(10, 9); \
const byte direccion[6] = "PEDAL";\
\
// Data Structure (Switches removed, only Potentiometer)\
struct DatosPedal \{\
  int valorPot;    \
\};\
\
DatosPedal miPedal;\
\
void setup() \{\
  Serial.begin(9600);\
  Serial.println(F("--- PEDAL TRANSMITTER V5.0 ---"));\
\
  if (!radio.begin()) \{\
    Serial.println(F("Error: Radio hardware not detected"));\
    while (1); \
  \}\
\
  radio.openWritingPipe(direccion);\
  radio.setPALevel(RF24_PA_LOW); // Enhances power stability    \
  radio.setDataRate(RF24_250KBPS); \
  radio.stopListening();\
\}\
\
void loop() \{\
  // Read Potentiometer value\
  miPedal.valorPot = analogRead(A0);\
\
  // Send data\
  bool ok = radio.write(&miPedal, sizeof(DatosPedal));\
  imprimirActividad(ok);\
  \
  delay(50); \
\}\
\
void imprimirActividad(bool exito) \{\
  static unsigned long lastPrint = 0;\
  if (millis() - lastPrint > 250) \{\
    Serial.print(F("POT: ")); Serial.print(miPedal.valorPot);\
    Serial.println(exito ? F(" | STATUS: OK") : F(" | STATUS: ERROR"));\
    lastPrint = millis();\
  \}\
\}\
